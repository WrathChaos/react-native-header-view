{
  "name": "@freakycoder/react-native-header-view",
  "version": "1.2.0",
  "description": "Collection of customizable Header Views for React Native (Gorgeous, Apple, Modern, Classic, Profile, Elegant).",
  "keywords": [
    "react-native",
    "react-native-header",
    "header",
    "header-view",
    "elegant-header",
    "gorgeous-header",
    "apple-header",
    "modern-header",
