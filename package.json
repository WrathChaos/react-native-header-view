    "profile-header",
    "navbar",
    "navigation-bar",
    "ui-lib",
    "ios",
    "android"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "react-native": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./lib/index.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/kuraydev/react-native-header-view#readme",
  "bugs": {
    "url": "https://github.com/kuraydev/react-native-header-view/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraydev/react-native-header-view.git"
  },
  "author": "Kuray (FreakyCoder) <kurayogun@gmail.com>",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "jest",
    "build": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.55.0",
    "react-native-apple-header": ">=0.1.0",
    "react-native-classic-header": ">=0.1.0",
    "react-native-elegant-header": ">=0.1.0",
    "react-native-gorgeous-header": ">=0.1.0",
    "react-native-modern-header": ">=0.1.0",
    "react-native-profile-header": ">=0.1.0"
  },
